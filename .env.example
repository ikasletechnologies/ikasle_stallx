# StallX AI assistant — read ONLY by the server (/api/chat).
# Do NOT prefix these with VITE_: VITE_ variables are bundled into the public website code.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional: override the API endpoint
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Contact form email (Gmail SMTP) — read ONLY by the server (/api/contact).
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password: Google Account → Security → 2-Step Verification → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=your16letterapppassword
# Inbox that receives new enquiries (defaults to SMTP_USER if empty)
CONTACT_RECEIVER=businessgroupikasle@gmail.com
CONTACT_FROM_NAME=Ikaslé StallX
